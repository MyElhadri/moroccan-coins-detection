# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# YOLOv8 outputs and training weights
*.pt
*.onnx
runs/

# Keep folders structure in git but ignore local raw images
data/raw_images/coin_1dh/*
!data/raw_images/coin_1dh/.gitkeep
data/raw_images/coin_2dh/*
!data/raw_images/coin_2dh/.gitkeep
data/raw_images/coin_5dh/*
!data/raw_images/coin_5dh/.gitkeep
data/raw_images/coin_10dh/*
!data/raw_images/coin_10dh/.gitkeep
data/raw_images/mixed_coins/*
!data/raw_images/mixed_coins/.gitkeep

# Ignore dataset images and labels (they will be populated from Roboflow or locally)
data/dataset_yolo/train/images/*
!data/dataset_yolo/train/images/.gitkeep
data/dataset_yolo/train/labels/*
!data/dataset_yolo/train/labels/.gitkeep
data/dataset_yolo/valid/images/*
!data/dataset_yolo/valid/images/.gitkeep
data/dataset_yolo/valid/labels/*
!data/dataset_yolo/valid/labels/.gitkeep
data/dataset_yolo/test/images/*
!data/dataset_yolo/test/images/.gitkeep
data/dataset_yolo/test/labels/*
!data/dataset_yolo/test/labels/.gitkeep

# Ignore test images and results
data/test_images/*
!data/test_images/.gitkeep
results/predictions/*
!results/predictions/.gitkeep
results/screenshots/*
!results/screenshots/.gitkeep

# Streamlit configurations
.streamlit/
